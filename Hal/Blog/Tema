<script>
function getZonaIndonesia() {

  const zona = Intl.DateTimeFormat().resolvedOptions().timeZone;

  const WITA = [
    "Asia/Makassar",
    "Asia/Ujung_Pandang"
  ];

  const WIT = [
    "Asia/Jayapura"
  ];

  if (WITA.includes(zona)) {
    return {
      label: "WITA",
      offset: 8
    };
  }

  if (WIT.includes(zona)) {
    return {
      label: "WIT",
      offset: 9
    };
  }

  return {
    label: "WIB",
    offset: 7
  };
}

function updateWaktu(){

  const hariList = [
    "Minggu","Senin","Selasa",
    "Rabu","Kamis","Jumat","Sabtu"
  ];

  const bulanList = [
    "Januari","Februari","Maret",
    "April","Mei","Juni",
    "Juli","Agustus","September",
    "Oktober","November","Desember"
  ];

  const zona = getZonaIndonesia();

  const sekarang = new Date();

  const utc = sekarang.getTime() +
              (sekarang.getTimezoneOffset() * 60000);

  const lokal = new Date(
    utc + (3600000 * zona.offset)
  );

  const hari = hariList[lokal.getDay()];
  const tanggal = lokal.getDate();
  const bulan = bulanList[lokal.getMonth()];
  const tahun = lokal.getFullYear();

  const jam = String(lokal.getHours()).padStart(2,"0");
  const menit = String(lokal.getMinutes()).padStart(2,"0");
  const detik = String(lokal.getSeconds()).padStart(2,"0");

  document.getElementById("waktu-blogger").innerHTML =
    `${hari}, ${tanggal} ${bulan} ${tahun} | ${jam}:${menit}:${detik} ${zona.label}`;
}

updateWaktu();
setInterval(updateWaktu,1000);
</script>

