<!-- TEMPAT NAVIGASI MENU TAB DAN KONTEN ANDA -->
<div class="tab-menu" id="tabMenu"></div>
<div id="tabContents"></div>

<script>
  const blogJsonURL = 'https://tv-chenxdayat.blogspot.com/p/backup-json-file-tv.html';

  async function loadJsonAndRender() {
    try {
      const response = await fetch(blogJsonURL);
      if (!response.ok) throw new Error('Gagal terhubung ke halaman data blog');
      
      const htmlText = await response.text();

      const parser = new DOMParser();
      const doc = parser.parseFromString(htmlText, 'text/html');
      
      const jsonScript = doc.querySelector('script[type="application/json"]');

      if (!jsonScript || !jsonScript.textContent.trim()) {
        throw new Error('Tag <script type="application/json"> tidak ditemukan atau isinya kosong di blog penyimpan.');
      }

      const jsonData = JSON.parse(jsonScript.textContent);
      renderTabs(jsonData);

    } catch (error) {
      console.error("Gagal memuat JSON dari Blog:", error);
      
      const tabMenu = document.getElementById('tabMenu');
      if(tabMenu) {
        tabMenu.innerHTML = `<p style="color:red; font-size:12px; padding:10px;">Gagal memuat Menu Tab. Alasan: ${error.message}</p>`;
      }
    }
  }

  function setPlayerUrlProxy(urlTarget) {
    const frameContainer = document.getElementById('tvFrameContainer');
    const iframe = document.getElementById('tvPlayer');

    iframe.src = '';
    
    setTimeout(() => {
      iframe.src = urlTarget;
    }, 50);
    
    frameContainer.style.display = 'block';
    
    if (window.innerWidth > 767) {
      frameContainer.scrollIntoView({ behavior: 'smooth' });
    }
  }

  // =======================================================================
  // PERBAIKAN UTAMA: Mengubah Jam Sekaligus Tanggal Otomatis Jika Lewat Malam
  // =======================================================================
  function konversiWaktuDanTanggalLokal(jamMentah, tanggalMentah) {
    try {
      // 1. Pecah Jam dan Menit
      let pemisahJam = jamMentah.includes('.') ? '.' : ':';
      const partJam = jamMentah.trim().split(pemisahJam);
      if (partJam.length !== 2) return `${jamMentah} | ${tanggalMentah}`;
      
      const jam = String(partJam[0]).padStart(2, '0');
      const menit = String(partJam[1]).padStart(2, '0');

      // 2. Ubah Teks Tanggal Indonesia (Contoh: "3 Agustus 2026") Menjadi Angka Komputer
      const bulanList = ["januari", "februari", "maret", "april", "mei", "juni", "juli", "agustus", "september", "oktober", "november", "desember"];
      
      const partTgl = tanggalMentah.trim().split(' ');
      if (partTgl.length !== 3) return `${jamMentah} | ${tanggalMentah}`; // Jaga-jaga jika format salah

      const tglAngka = String(partTgl[0]).padStart(2, '0');
      const namaBulan = partTgl[1].toLowerCase();
      const thnAngka = partTgl[2];

      // Cari urutan angka bulan (01 sampai 12)
      let indexBulan = bulanList.indexOf(namaBulan);
      if (indexBulan === -1) indexBulan = 0; // Fallback ke Januari jika tidak cocok
      const blnAngka = String(indexBulan + 1).padStart(2, '0');

      // 3. Satukan Menjadi Standar Waktu ISO Berbasis WIB (+07:00)
      // Format hasil: "2026-08-03T17:30:00+07:00"
      const formatIsoWib = `${thnAngka}-${blnAngka}-${tglAngka}T${jam}:${menit}:00+07:00`;
      const objekTanggalLokal = new Date(formatIsoWib);

      if (isNaN(objekTanggalLokal.getTime())) return `${jamMentah} | ${tanggalMentah}`;

      // 4. Ambil Nilai Hasil Kalkulasi Waktu yang Baru Sesuai HP Pengunjung
      const jamHasil = String(objekTanggalLokal.getHours()).padStart(2, '0');
      const menitHasil = String(objekTanggalLokal.getMinutes()).padStart(2, '0');
      const tglHasil = objekTanggalLokal.getDate();
      const blnHasilNama = bulanList[objekTanggalLokal.getMonth()];
      const thnHasil = objekTanggalLokal.getFullYear();

      // Huruf kapital awal nama bulan (contoh: agustus -> Agustus)
      const blnHasilKapital = blnHasilNama.charAt(0).toUpperCase() + blnHasilNama.slice(1);

      // 5. Deteksi Wilayah Label Waktu
      const tz = Intl.DateTimeFormat().resolvedOptions().timeZone;
      let labelZona = "WIB";
      if (tz.includes("Makassar") || tz.includes("Manado") || tz.includes("Denpasar") || tz.includes("Makasar")) {
        labelZona = "WITA";
      } else if (tz.includes("Jayapura") || tz.includes("Ambon")) {
        labelZona = "WIT";
      }

      // Gabungkan hasil akhir: "19.30 WITA | 3 Agustus 2026" atau "01.30 WIT | 4 Agustus 2026"
      return `${jamHasil}.${menitHasil} ${labelZona} | ${tglHasil} ${blnHasilKapital} ${thnHasil}`;

    } catch (e) {
      return `${jamMentah} | ${tanggalMentah}`;
    }
  }

  function renderTabs(jsonData) {
    const kategoriLabels = { 
      bola: 'SEPAKBOLA', 
      voli: 'VOLLEY', 
      balapan: 'BALAP', 
      other: 'TV Biasa' 
    };
    
    const tabMenu = document.getElementById('tabMenu');
    const tabContents = document.getElementById('tabContents');
    tabMenu.innerHTML = ''; 
    tabContents.innerHTML = '';

    let firstTab = true;
    for (const kategori in jsonData) {
      const btn = document.createElement('button');
      btn.textContent = kategoriLabels[kategori] || kategori.toUpperCase();
      btn.className = 'tablink' + (firstTab ? ' active' : '');
      btn.dataset.tab = kategori;
      btn.onclick = (e) => { openTab(e.target.dataset.tab); };
      tabMenu.appendChild(btn);
      firstTab = false;
    }

    firstTab = true;
    for (const kategori in jsonData) {
      const tabDiv = document.createElement('div');
      tabDiv.id = kategori;
      tabDiv.className = 'tab-content' + (firstTab ? ' active' : '');
      const container = document.createElement('div');
      container.className = 'match-container';

      jsonData[kategori].forEach(item => {
        // MODE TV CHANNEL (Hanya Logo)
        if(item.logo && item.url){
          const logoBox = document.createElement('div');
          logoBox.className = 'tv-logo-item';
          logoBox.innerHTML = `<img src="${item.logo}" alt="TV Channel" loading="lazy">`;

          logoBox.onclick = () => {
            setPlayerUrlProxy(item.url);
          };
          container.appendChild(logoBox);

        } else {

          let tampilanWaktuLengkap = "";
          
          if (item.date) {
            if (item.date.includes('|')) {
              const bagianWaktu = item.date.split('|');
              const jamMentah = bagianWaktu[0].trim(); 
              const tanggalMentah = bagianWaktu[1].trim(); 
              
              // PERBAIKAN: Melempar jam dan tanggal secara bersamaan ke dalam mesin kalkulator
              tampilanWaktuLengkap = konversiWaktuDanTanggalLokal(jamMentah, tanggalMentah);
            } else {
              // Jika data di JSON Anda suatu saat lupa tidak diberi pemisah tanggal, tetap aman
              tampilanWaktuLengkap = item.date; 
            }
          }

          const card = document.createElement('div');
          card.className = 'match-card';
          card.innerHTML = `
            <div class="match-time">${tampilanWaktuLengkap}</div>
            <div class="league">${item.league}</div>
            <div class="teams">
              <div class="team">
                <img src="${item.logo1}" alt="${item.team1}" class="team-logo">
                <span class="team-name">${item.team1}</span>
                <span class="vs">-</span>
                <span class="team-name">${item.team2}</span>
                <img src="${item.logo2}" alt="${item.team2}" class="team-logo">
              </div>
            </div>
            <div class="channel-buttons">
              ${item.channels.map(ch => `<button data-url="${ch.url}">${ch.label}</button>`).join('')}
            </div>
          `;

          const buttons = card.querySelectorAll('button');
          buttons.forEach(btn => {
            btn.addEventListener('click', () => {
              setPlayerUrlProxy(btn.dataset.url);
            });
          });
          container.appendChild(card);
        }
      });

      tabDiv.appendChild(container);
      tabContents.appendChild(tabDiv);
      firstTab = false;
    }
  }

  function openTab(tabName) {
    document.querySelectorAll('.tab-menu button').forEach(btn => { btn.classList.toggle('active', btn.dataset.tab === tabName); });
    document.querySelectorAll('.tab-content').forEach(div => { div.classList.toggle('active', div.id === tabName); });
  }

  loadJsonAndRender();
</script>

