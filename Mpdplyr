<!-- Bagian 1: Dokumen Utama & Gaya CSS Player MPD -->
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="referrer" content="no-referrer">
<meta name="robots" content="noindex">
<meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">

<title>Live Player Shaka MPD</title>

<!-- Pustaka Shaka Player & UI Berwarna -->
<script src="https://cdn.jsdelivr.net/npm/shaka-player/dist/shaka-player.ui.min.js" crossorigin="anonymous"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/crypto-js/3.1.9-1/crypto-js.js" crossorigin="anonymous"></script>
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/shaka-player/dist/controls.min.css" crossorigin="anonymous">

<style>
/* KUNCI UTAMA: Trik Fullscreen Andalan Khas Bos */
.video-container {
    position: fixed !important;
    top: 0 !important;
    left: 0 !important;
    width: 100% !important;
    height: 100% !important;
    z-index: 9999 !important;
    background: #000000 !important;
    display: flex !important;
    align-items: flex-start !important;
    justify-content: center !important;
    overflow: hidden !important;
}

html, body {
    margin: 0;
    padding: 0;
    width: 100%;
    height: 100%;
    background: #000;
    overflow: hidden;
}

#video {
    width: 100% !important;
    height: 100% !important;
}

/* GAYA WATERMARK KHUSUS LAYER SHAKA PLAYER */
.watermark {
    position: absolute !important;
    bottom: 50px !important; /* Pas di atas control bar Shaka */
    right: 5% !important;
    color: #ffffff !important; 
    font-family: Cambria, "Times New Roman", serif !important;
    font-size: 11px !important;
    font-weight: bold !important;
    text-shadow: 2px 2px 3px #000 !important;
    z-index: 1 !important; /* Sinkron dengan Shadow DOM Shaka */
    pointer-events: none !important; 
    user-select: none !important;
}

#loader {
    position: absolute;
    inset: 0;
    display: none; 
    align-items: center;
    justify-content: center;
    background-image: url(''); 
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
    color: #fff;
    font-size: 18px;
    z-index: 4 !important; /* Menutupi seluruh lapisan terdalam */
}

#loader::before {
    content: "";
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.4); 
    z-index: -1;
}

/* GAYA NOTIFBOX KHUSUS LAYER SHAKA PLAYER */
#notifBox {
    position: absolute !important; 
    left: 15px !important;
    bottom: 60px !important; 
    width: 240px !important;
    display: flex !important;
    align-items: center !important;
    gap: 10px !important;
    padding: 12px !important;
    border-radius: 14px !important;
    color: #fff !important;
    background: rgba(30, 30, 30, .75) !important;
    backdrop-filter: blur(12px) !important;
    -webkit-backdrop-filter: blur(12px) !important;
    box-shadow: 0 10px 25px rgba(0,0,0,.35) !important;
    cursor: pointer !important;
    z-index: 2 !important; /* Di atas tombol play tapi di bawah loader */
    opacity: 0;
    transform: translateY(25px);
    transition: .35s;
    pointer-events: none; 
}

#notifBox.show {
    opacity: 1;
    transform: translateY(0);
    pointer-events: auto; 
}

#notifBox img {
    width: 35px;
    height: 35px;
    flex-shrink: 0;
}

.notifText {
    font-size: 10px;
    font-family: Cambria, "Times New Roman", serif;
    font-weight: bold;
    line-height: 1.4;
}

#closeNotif {
    position: absolute;
    top: 6px;
    right: 8px;
    font-size: 12px;
    opacity: .7;
    cursor: pointer;
}

#closeNotif:hover {
    opacity: 1;
}
</style>
</head>

<body>
<!-- Bagian 2: Struktur Elemen Pembungkus Player Video MPD (Murni Manual) -->
<div class="video-container" id="video-container">
    <video id="video" autoplay playsinline></video>

    <!-- ELEMEN WATERMARK BOS -->
    <div class="watermark" id="myWatermark">CHENX-DAYAT</div>
    
    <!-- ELEMEN LOADER GAMBAR -->
    <div id="loader">Connecting...</div>

    <!-- ELEMEN NOTIFBOX -->
    <div id="notifBox">
        <img src="https://bit.ly/4fCyTqu" alt="Notif">
        <div class="notifText" id="notifTextContent">CHENX-DAYAT:<br>"Halo bos! Selamat menonton."</div>
        <div id="closeNotif">✕</div>
    </div>
</div>

<!-- Bagian 3: Logika Core Player MPD, DRM ClearKey, Lock 480p, Fullscreen & Anti-Adblock -->
<script>
    // --- KONFIGURASI PARAMETER URL ---
    function getQueryParam(name){
        return new URLSearchParams(window.location.search).get(name);
    }

    const MPD_URL = getQueryParam("src") || "https://at-live-99.tentcdn.eu/bpk-tv/WM_TV_1_UHD/default/index.mpd"; 
    
    // Kunci DRM ClearKeys bawaan asal bos
    const KEYS = {
      "4f558eae1b005126b2ac6e9eb1a7849e": "17aea325d91b5e66f06a8c574f2f0b03",
      "b73f76658d1f5ce38420f380421bafe3": "9ebdbf32f90b546f66603104b2ac3c8a",
      "e1f8fc6898fc5bf7a00b5609af23fee0": "98b7133ee006d9fae111ec0cb366641c",
      "e511fb81360c5f14b681605d1de52046": "ec72f335d0e436ac7dc1d936aea1144a"
    };
  
    // Fungsi pengubah kode Hexadecimal ke Base64 agar dikenali mesin Shaka Player
    function hexToB64(hex) {
        return btoa(hex.match(/\w{2}/g).map(a => String.fromCharCode(parseInt(a, 16))).join(""))
            .replace(/\+/g, '-').replace(/\//g, '_').replace(/=+$/, '');
    }

    let shakaPlayerInstance;
    let notifTimeout;
    let isAdblockActive = false;

    // --- STRATEGI ANTI-ADBLOCK JEBAKAN ---
    const adJebakan = document.createElement('div');
    adJebakan.id = 'bottom-ads-banner';
    adJebakan.className = 'adsbox ads-partner pub_300x250';
    adJebakan.style.position = 'absolute';
    adJebakan.style.left = '-9999px';
    adJebakan.style.height = '1px';
    document.body.appendChild(adJebakan);

    window.addEventListener('DOMContentLoaded', () => {
        if (adJebakan.offsetHeight === 0 || window.getComputedStyle(adJebakan).display === 'none') {
            isAdblockActive = true;
        }
    });

    async function initPlayer() {
        const video = document.getElementById('video');
        const container = document.getElementById('video-container');
        const loader = document.getElementById('loader');

        if (loader) loader.style.display = 'flex';

        // PENGAMAN: Cek duplikasi UI Shaka
        if (video['ui']) {
            return; 
        }

        // 1. Inisialisasi Engine Core Player
        const player = new shaka.Player(video);
        shakaPlayerInstance = player;
        
        // 2. Inisialisasi Lapisan Overlay UI secara manual
        const ui = new shaka.ui.Overlay(player, container, video);
        
        // 3. Susunan Tombol Kontrol Bawaan Shaka
        const uiConfig = {
            'controlPanelElements': [
                'play_pause', 
                'time_and_duration', 
                'spacer', 
                'mute', 
                'volume', 
                'quality',   
                'fullscreen', 
                'overflow_menu' 
            ],
            'addLanguageControls': true,
            'castReceiverAppId': 'CC1AD845', 
            'clearBufferOnQualityChange': true 
        };
        ui.configure(uiConfig);

        // INJEKSI AMAN KE LAYER SHAKA VIDEO CONTAINER (Biar tidak memudar / hilang saat kontrol disembunyikan)
        const shakaVideoContainer = container.querySelector('.shaka-video-container');
        const watermark = document.getElementById('myWatermark');
        const notifBox = document.getElementById('notifBox');
        if (shakaVideoContainer) {
            if (watermark) shakaVideoContainer.appendChild(watermark);
            if (notifBox) shakaVideoContainer.appendChild(notifBox);
        }

        // LOCK KUALITAS MAKSIMAL 480P TERDEKAT
        player.addEventListener('variantchanged', () => {
            const tracks = player.getVariantTracks();
            let targetTrack = null;
            let maxDiff = -Infinity;

            tracks.forEach((track) => {
                if (track.height && track.height <= 480) {
                    if (track.height > maxDiff) {
                        maxDiff = track.height;
                        targetTrack = track;
                    }
                }
            });

            if (targetTrack) {
                player.configure({ abr: { enabled: false } });
                player.selectVariantTrack(targetTrack, true);
            }
        });

        // 4. Pengolahan Data Kunci DRM ClearKey
        const cleanKeys = {};
        for (const [kid, key] of Object.entries(KEYS)) {
            cleanKeys[hexToB64(kid)] = hexToB64(key);
        }

        player.configure({
            drm: { clearKeys: cleanKeys }
        });

        // Deteksi otomatis status video untuk memunculkan gambar loading saat buffering di jalan
        video.addEventListener('waiting', () => { if (loader) loader.style.display = 'flex'; });
        video.addEventListener('playing', () => { if (loader) loader.style.display = 'none'; });

        try {
            await player.load(MPD_URL);
            setTimeout(() => { if (loader) loader.style.display = 'none'; }, 1500);
            setTimeout(periksaAdblockAction, 3000); // Cek Adblock setelah 3 detik siaran jalan
        } catch (e) {
            console.error('Error load:', e);
            if (loader) loader.style.display = 'flex';
            setTimeout(async () => {
                try {
                    await player.load(MPD_URL);
                    video.play();
                } catch (retryErr) {}
            }, 3000); // Auto-retry jika gagal muat awal
        }
    }

    // EKSEKUSI JIKA USER MEMAKAI ADBLOCK
    function periksaAdblockAction() {
        if (isAdblockActive) {
            const textNotif = document.getElementById('notifTextContent');
            if (textNotif) {
                textNotif.innerHTML = "<span style='color:#ff4d4d;'>ADBLOCK TERDETEKSI!</span><br>Matikan AdBlock untuk kelancaran live streaming.";
            }
            showNotif(true); // Paksa notifikasi mengunci abadi di layar
        }
    }

    // Buka suara (Unmute) siaran & Auto Fullscreen Android otomatis saat penonton mengetuk layar pertama kali
    function handleFirstInteraction() {
        const video = document.getElementById('video');
        if (video) video.muted = false;

        const isIOS = /iPad|iPhone|iPod/.test(navigator.userAgent);
        if (!isIOS && window.innerWidth < 768 && shakaPlayerInstance) {
            const container = document.getElementById('video-container');
            if (container) {
                try {
                    if (container.requestFullscreen) {
                        container.requestFullscreen();
                    } else if (container.webkitRequestFullscreen) {
                        container.webkitRequestFullscreen();
                    }
                } catch (err) {}
            }
        }
    }

    document.addEventListener("click", handleFirstInteraction, {once:true});
    document.addEventListener("touchstart", handleFirstInteraction, {once:true});

    // --- MANAJEMEN WAKTU NOTIFIKASI ---
    function showNotif(forceStay = false){
        const notifBox = document.getElementById("notifBox");
        if(notifBox) {
            clearTimeout(notifTimeout);
            notifBox.classList.add("show");
            if (!forceStay) {
                notifTimeout = setTimeout(function(){
                    notifBox.classList.remove("show");
                }, 8000); // Pesan melayang tampil selama 8 detik normal
            }
        }
    }

    if(notifBox) {
        notifBox.addEventListener("click", function(){ 
            if (isAdblockActive) {
                alert("Mohon matikan ekstensi AdBlock / uBlock di browser Anda lalu refresh halaman.");
            } else {
                window.open("https://google.com", "_blank"); // Masukkan link iklan normal di sini bos
            }
        });
    }
    
    const closeBtn = document.getElementById("closeNotif");
    if(closeBtn) {
        closeBtn.addEventListener("click", function(e){
            e.stopPropagation(); // Biar klik silang tidak memicu buka tautan baru
            clearTimeout(notifTimeout);
            if(notifBox) notifBox.classList.remove("show");
        });
    }

    // Setelan kemunculan berkala (Jika kondisi aman tanpa Adblock)
    setTimeout(() => { if(!isAdblockActive) showNotif(); }, 3000);
    setInterval(() => { if(!isAdblockActive) showNotif(); }, 1200000);

    // Perintah eksekusi utama saat seluruh pustaka Shaka UI siap dimuat
    document.addEventListener('shaka-ui-loaded', initPlayer);
</script>
</body>
</html>
