<!--DOCTYPE html-->
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="referrer" content="no-referrer">
<meta name="robots" content="noindex">
<meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">

<title>Live Player</title>

<script src="https://cdn.jwplayer.com/libraries/SAHhwvZq.js"></script>

<style>
/* KUNCI UTAMA: Trik Fullscreen Andalan Khas Bos */
.video-container {
    position: fixed !important;
    top: 0 !important;
    left: 0 !important;
    width: 100% !important;
    height: 100% !important;
    z-index: 9999 !important; /* Prioritas tampil mutlak menyelimuti iframe */
    background: #000000 !important;
    display: flex !important;
    align-items: flex-start !important;
    justify-content: center !important;
    overflow: hidden !important;
}

html,body{
    margin:0;
    padding:0;
    width:100%;
    height:100%;
    background:#000;
    overflow:hidden;
}

#jwplayerDiv{
    width:100% !important;
    height:100% !important;
}

/* GAYA WATERMARK TETAP AMAN DI FULLSCREEN */
.video-watermark {
    position: absolute !important;
    bottom: 1px !important; /* DIUBAH: Naikkan sedikit agar aman di atas bar control jw-wrapper bawaan */
    right: 5% !important;
    color: #ffffff !important; /* Warna putih */
    font-family: Cambria,"Times New Roman",serif !important;
    font-size: 11px !important;
    font-weight: bold !important;
    text-shadow: 2px 2px 3px #000 !important;
    z-index: 99999 !important; /* DINAIKKAN: Menyesuaikan layer video container */
    pointer-events: none !important; /* Klik tembus ke video */
    user-select: none !important;
}

/* DIKEMBALIKAN KE DISPLAY NONE AGAR TIDAK MENGUNCI VIDEO */
#loader{
    position:absolute;
    inset:0;
    display:none; 
    align-items:center;
    justify-content:center;
    
    /* URL Gambar Background Loading */
    background-image: url(''); 
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
    
    color:#fff;
    font-size:18px;
    z-index:999999; /* DINAIKKAN: Supaya menutupi seluruh elemen saat buffer */
}

#loader::before {
    content: "";
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.4); /* Gelap tipis 40% */
    z-index: -1;
}

#notifBox{
    position: relative; /* DIUBAH: Menggunakan absolute agar terkunci di dalam player saat fullscreen */
    left: 15px;
    bottom: 100px; /* DIUBAH: Disesuaikan posisinya agar proporsional */
    width: 240px;

    display: flex;
    align-items: center;
    gap: 10px;

    padding: 12px;
    border-radius: 14px;

    color: #fff;
    background: rgba(30,30,30,.75);

    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);

    box-shadow: 0 10px 25px rgba(0,0,0,.35);

    cursor: pointer;
    z-index: 99999; /* DINAIKKAN: Muncul aman di atas player */

    opacity: 0;
    transform: translateY(25px);
    transition: .35s;
    
    pointer-events: none; /* DITAMBAHKAN: Membuat klik tembus ke player saat notif sedang sembunyi */
}

#notifBox.show{
    opacity: 1;
    transform: translateY(0);
    pointer-events: auto; /* DITAMBAHKAN: Mengaktifkan fungsi klik kembali hanya saat notif sedang muncul */
}

#notifBox img{
    width:35px;
    height:35px;
    border-radius: 50%;
    flex-shrink:0;
}

.notifText{
    font-size:10px;
    font-family: Cambria,"Times New Roman",serif;
    font-weight: bold;
    line-height:1.4;
}

/* Pengaturan Tombol Close di Pojok Kanan Atas */
#closeNotif {
    position: absolute;
    top: 8px;            /* Jarak dari atas kotak */
    right: 8px;          /* Jarak dari kanan kotak */
    width: 16px;         /* Lebar area tombol */
    height: 16px;        /* Tinggi area tombol */
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    color: #ffffff;      /* Ganti warna ikon sesuai kebutuhan (misal: #fff untuk putih) */
    transition: opacity 0.2s;
}

/* Efek sedikit pudar saat diarahkan kursor */
#closeNotif:hover {
    opacity: 0.7;
}
</style>
</head>

<body>

<!-- PEMBUNGKUS TRIK FULLSCREEN ANDALAN BOS -->
<div class="video-container">

    <div id="jwplayerDiv"></div>

    <!-- ELEMEN WATERMARK -->
    <div class="video-watermark" id="myWatermark">CHENX-DAYAT</div>

    <div id="loader">
        Connecting...
    </div>

    <!-- ELEMEN NOTIFBOX -->
<div id="notifBox">
    <img src="https://bit.ly/4fCyTqu" alt="Notif">
    <div class="notifText">CHENX-DAYAT:<br>"Halo bos! Selamat menonton."</div>
    <div id="closeNotif">
        <svg xmlns="http://w3.org" width="100%" height="100%" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <line x1="18" y1="6" x2="6" y2="18"></line>
            <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
    </div>
</div>

</div>
  
<script>
function getQueryParam(name){
    return new URLSearchParams(window.location.search).get(name);
}

const streamUrl =
    getQueryParam("src") ||
    "https://1nyaler.streamhostingcdn.top/stream/20/index.m3u8";

const player = jwplayer("jwplayerDiv");

player.setup({
    file: streamUrl,
    width: "100%",
    height: "100%",
    aspectratio: "16:9",
    autostart: true,
    mute: true,
    playsinline: true,
    preload: "auto",
    type: "hls",
    hlshtml: true,
    stretching: "uniform",
    playbackRateControls: false,
    cast: {
        appid: "CC1AD845"
    }
});

/* Paksa tampilkan gambar loader begitu player di-setup */
document.getElementById("loader").style.display = "flex";

/* PERBAIKAN: STRUKTUR INJEKSI DOM (Menggunakan appendChild ke jw-wrapper) */
player.on("ready", function() {
    const watermark = document.getElementById("myWatermark");
    const notifBox = document.getElementById("notifBox");
    const jwWrapper = document.querySelector(".jw-wrapper");
    
    if (jwWrapper) {
        if (watermark) jwWrapper.appendChild(watermark);
        if (notifBox) jwWrapper.appendChild(notifBox);
    }
    
    /* PENGAMAN EKSTRA: Jika video langsung siap tanpa buffer, tutup gambarnya */
    setTimeout(function(){
        if(player.getState() === "playing" || player.getState() === "paused"){
            document.getElementById("loader").style.display = "none";
        }
    }, 1500);
});

/* PERBAIKAN: LOGIKA PEMILIHAN KUALITAS AWAL (Maksimal 480p paling mendekati) */
player.on("levels", function(e){
    let target = 0;
    let maxDiff = -Infinity;
    
    e.levels.forEach((level, index) => {
        if (level.height && level.height <= 480) {
            if (level.height > maxDiff) {
                maxDiff = level.height;
                target = index;
            }
        }
    });
    player.setCurrentQuality(target);
});

/* Loader kontrol */
player.on("buffer", function(){
    document.getElementById("loader").style.display = "flex";
});

player.on("play", function(){
    document.getElementById("loader").style.display = "none";
});

player.on("firstFrame", function(){
    document.getElementById("loader").style.display = "none";
});

/* PERBAIKAN: Unmute & Auto Fullscreen Android yang Valid (Sesuai Aturan User Gesture) */
function handleFirstInteraction() {
    player.setMute(false);
    
    // Trik Auto Fullscreen dipindah ke sini agar disetujui browser Android
    const isIOS = /iPad|iPhone|iPod/.test(navigator.userAgent);
    if(!isIOS && window.innerWidth < 768){
        try{
            player.setFullscreen(true);
        }catch(err){}
    }
}

document.addEventListener("click", handleFirstInteraction, {once:true});
document.addEventListener("touchstart", handleFirstInteraction, {once:true});

/* Auto retry */
player.on("error", function(){
    document.getElementById("loader").style.display = "flex";
    setTimeout(function(){
        player.load([{ file: streamUrl, type: "hls" }]);
        player.play(true);
    },3000);
});

/* PERBAIKAN: KONTROL NOTIFIKASI BEBAS GLITCH */
const notifBox = document.getElementById("notifBox");
let notifTimeout;

function showNotif(){
    clearTimeout(notifTimeout); // Bersihkan sisa waktu timeout sebelumnya jika ada tabrakan
    
    notifBox.classList.add("show");
    notifTimeout = setTimeout(function(){
        notifBox.classList.remove("show");
    }, 8000); // Notif hilang dalam 8 detik
}

notifBox.addEventListener("click", function(){
    window.open("", "_blank"); // Masukkan link iklan/tujuan di sini
});

document.getElementById("closeNotif").addEventListener("click", function(e){
    e.stopPropagation();
    clearTimeout(notifTimeout);
    notifBox.classList.remove("show");
});

// WAKTU PEMANGGILAN NOTIF
setTimeout(showNotif, 3000);
setInterval(showNotif, 1200000);
</script>

</body>
</html>
